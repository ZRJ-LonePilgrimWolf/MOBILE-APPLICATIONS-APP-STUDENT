<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="accentTextColor">@color/accent_navy_text</item>
        <item name="android:statusBarColor">@color/accent_navy</item>
        <item name="android:navigationBarColor">@color/p</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="O_MR1">true</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />

    <!-- The 4 colour choices. ThemeHelper picks one before each screen is built. -->
    <style name="Theme.MyApplication.Navy">
        <item name="colorPrimary">@color/accent_navy</item>
        <item name="accentTextColor">@color/accent_navy_text</item>
        <item name="colorControlActivated">@color/accent_navy_text</item>
        <item name="android:statusBarColor">@color/accent_navy</item>
    </style>
    <style name="Theme.MyApplication.Blue">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="accentTextColor">@color/accent_blue_text</item>
        <item name="colorControlActivated">@color/accent_blue_text</item>
        <item name="android:statusBarColor">@color/accent_blue</item>
    </style>
    <style name="Theme.MyApplication.Purple">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="accentTextColor">@color/accent_purple_text</item>
        <item name="colorControlActivated">@color/accent_purple_text</item>
        <item name="android:statusBarColor">@color/accent_purple</item>
    </style>
    <style name="Theme.MyApplication.Teal">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="accentTextColor">@color/accent_teal_text</item>
        <item name="colorControlActivated">@color/accent_teal_text</item>
        <item name="android:statusBarColor">@color/accent_teal</item>
    </style>
</resources>